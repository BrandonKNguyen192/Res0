# Res0 environment. Copy to .env — or better, let `stripe projects env --pull` write it.
# THIS REPOSITORY IS PUBLIC. Never commit a real .env.

# ── App ──────────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000

# ── Auth0 (Organizations) — provisioned via `stripe projects add auth0/client`
# The SDK v4 callback path is /auth/callback (mounted by middleware), NOT /api/auth/callback.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# openssl rand -hex 32
AUTH0_SECRET=

# ── Neon Postgres — provisioned via `stripe projects add neon/postgres`
# Neon writes NEON_POSTGRES_CONNECTION_STRING, not DATABASE_URL.
NEON_POSTGRES_CONNECTION_STRING=

# ── Stripe Billing ───────────────────────────────────────────────────────────
# Prefer a restricted key (rk_...): Customers, Checkout Sessions, Subscriptions,
# Billing Portal — write; everything else none.
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the webhook endpoint config in the Dashboard.
STRIPE_WEBHOOK_SECRET=
# The recurring per-venue Price (quantity = active venues).
STRIPE_PRICE_VENUE_MONTHLY=

# ── OpenRouter — provisioned via `stripe projects add openrouter/api` ────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
